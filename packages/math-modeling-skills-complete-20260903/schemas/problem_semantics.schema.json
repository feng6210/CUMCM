{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/cumcm/problem_semantics.schema.json",
  "title": "CUMCM Problem Semantics",
  "type": "object",
  "required": [
    "schema_version",
    "question_id",
    "raw_objective_phrases",
    "candidate_interpretations",
    "selected_interpretation",
    "selection_reason",
    "semantic_risk",
    "unresolved_ambiguities"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "question_id": {"type": "string", "minLength": 1},
    "raw_objective_phrases": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "identity_rule"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "identity_rule": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "candidate_interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mathematical_objective",
          "resource_accounting",
          "time_accounting",
          "assumptions_added",
          "downstream_effect"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mathematical_objective": {"type": "string", "minLength": 1},
          "resource_accounting": {"type": "string", "minLength": 1},
          "time_accounting": {"type": "string", "minLength": 1},
          "assumptions_added": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_for": {"type": ["string", "array"]},
          "evidence_against": {"type": ["string", "array"]},
          "downstream_effect": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "selected_interpretation": {"type": "string", "minLength": 1},
    "selection_reason": {"type": "string", "minLength": 1},
    "semantic_risk": {"enum": ["low", "medium", "high"]},
    "unresolved_ambiguities": {
      "type": "array",
      "items": {"type": "string"}
    },
    "decision_information_set": {
      "type": ["string", "object", "array"]
    },
    "source_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "sha256"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
