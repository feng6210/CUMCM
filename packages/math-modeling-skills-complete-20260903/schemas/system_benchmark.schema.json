{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/cumcm/system_benchmark.schema.json",
  "title": "CUMCM System Benchmark",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "task_mode",
    "structure_signature",
    "required_behaviors",
    "forbidden_behaviors",
    "acceptance"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "benchmark_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "task_mode": {"enum": ["training", "live_contest", "coursework", "research"]},
    "structure_signature": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "mechanism",
          "geometry",
          "prediction",
          "statistical_inference",
          "optimization",
          "simulation",
          "graph_network",
          "online_decision",
          "mixed"
        ]
      }
    },
    "source_scope": {"type": "string"},
    "required_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stage", "assertion"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "minLength": 1},
          "assertion": {"type": "string", "minLength": 8},
          "evidence_artifact": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "forbidden_behaviors": {
      "type": "array",
      "items": {"type": "string", "minLength": 8}
    },
    "acceptance": {
      "type": "object",
      "required": ["hard_fail_if", "pass_if"],
      "properties": {
        "hard_fail_if": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "pass_if": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
