{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/cumcm/final_submission_manifest.schema.json",
  "title": "CUMCM Final Submission Manifest",
  "type": "object",
  "required": [
    "schema_version", "status", "deliverable_mode", "question_decomposition",
    "expected_question_ids_field", "paper_pdf", "visual_binding", "support_zip",
    "question_completion"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "READY"},
    "deliverable_mode": {"const": "submission_package"},
    "question_decomposition": {"$ref": "#/$defs/artifact"},
    "expected_question_ids_field": {"const": "expected_question_ids"},
    "paper_pdf": {"$ref": "#/$defs/artifact"},
    "visual_binding": {"$ref": "#/$defs/artifact"},
    "support_zip": {"$ref": "#/$defs/artifact"},
    "question_completion": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id", "status", "paper_label", "result_artifacts", "validation_artifacts"
        ],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "status": {"const": "PASS"},
          "paper_label": {"type": "string", "minLength": 1},
          "result_artifacts": {
            "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}
          },
          "validation_artifacts": {
            "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
